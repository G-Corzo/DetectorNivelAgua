# Copy to .env and fill in local secrets. Do not commit .env.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=gateway
MQTT_PASSWORD=CAMBIAR_CLAVE_GATEWAY
MQTT_TELEMETRY_TOPIC=sabana/borda/hidrico/sensores
MQTT_ALARM_COMMAND_TOPIC=sabana/borda/hidrico/command/alarm
DEVICE_ID=tomine-01
DATABASE_PATH=data/gateway.sqlite3

# Optional ThingSpeak forwarding
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_MIN_INTERVAL_SECONDS=300

# Gemini reports and local reports dashboard
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_REPORT_INTERVAL_SECONDS=600
AI_REPORT_WINDOW_SECONDS=600
AI_REPORT_MIN_READINGS=3
AI_DASHBOARD_HOST=0.0.0.0
AI_DASHBOARD_PORT=8080
