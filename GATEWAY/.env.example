# Copiar a .env y completar. No subir .env ni claves al repositorio.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=gateway
MQTT_PASSWORD=CAMBIAR_CLAVE
MQTT_TELEMETRY_TOPIC=sabana/borda/hidrico/sensores
MQTT_ALARM_COMMAND_TOPIC=sabana/borda/hidrico/command/alarm
DEVICE_ID=tomine-01
DATABASE_PATH=data/gateway.sqlite3

# Ubidots STEM/cloud. El token se guarda solo en la Raspberry Pi.
UBIDOTS_TOKEN=
UBIDOTS_DEVICE_LABEL=tomine-01
UBIDOTS_HOST=industrial.api.ubidots.com
UBIDOTS_PORT=8883

# Opcional: IA generativa para recomendaciones explicables ante ALERTA/CRITICO.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
